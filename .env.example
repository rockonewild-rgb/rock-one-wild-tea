# Server Port
PORT=5000

# Resend Email Integration (https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=Rock One Wild Tea <onboarding@resend.dev>

# Concierge Notification Inbox (Where new customer inquiries will be sent)
CONCIERGE_EMAIL=axentrat@gmail.com

# Turso Cloud Database (Distributed SQLite / libSQL - https://turso.tech)
TURSO_DATABASE_URL=libsql://tea-factory-db-yourusername.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
TURSO_AUTO_SEED=false

# Supabase Cloud Database Configuration (Legacy / Alternative)
SUPABASE_URL=https://gozetekxnevnmwekrrhr.supabase.co
SUPABASE_KEY=sb_publishable_your_key_here

# PayPal Online Payment Gateway (https://developer.paypal.com/dashboard/)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_BUSINESS_EMAIL=rockonewild@gmail.com
PAYPAL_ME_URL=
